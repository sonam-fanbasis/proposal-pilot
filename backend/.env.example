# --- LLM provider -----------------------------------------------------------
# Leave GEMINI_API_KEY blank to run fully offline: retrieval, the vector index,
# metadata extraction and the evaluation harness all work without it, and
# answers become extractive quotations from your documents instead of generated
# prose. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# auto | gemini | offline   ("auto" picks gemini when a key is present)
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Must match the embedding model's width. text-embedding-004 is 768.
# Changing this requires re-ingesting the corpus.
EMBEDDING_DIM=768

# --- chunking ---------------------------------------------------------------
CHUNK_TARGET_CHARS=1100
CHUNK_OVERLAP_CHARS=180
CHUNK_MIN_CHARS=120

# --- retrieval --------------------------------------------------------------
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
FINAL_TOP_K=6
RRF_K=60
# Below this retrieval confidence the assistant declines to answer rather than
# generating from weak evidence.
MIN_CONFIDENCE=0.18

# --- server -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
